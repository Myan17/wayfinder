# Copy to .env (never committed). Values here are placeholders, not real credentials.

# --- GitHub App (installation source mode) ---
WAYFINDER_GITHUB_APP_ID=
WAYFINDER_GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem
WAYFINDER_GITHUB_WEBHOOK_SECRET=
WAYFINDER_GITHUB_OAUTH_CLIENT_ID=
WAYFINDER_GITHUB_OAUTH_CLIENT_SECRET=

# --- database ---
WAYFINDER_DATABASE_URL=postgresql://wayfinder:wayfinder@localhost:5432/wayfinder

# --- embeddings (local Ollama instances: one for queries, one for ingestion) ---
WAYFINDER_OLLAMA_QUERY_URL=http://localhost:11434
WAYFINDER_OLLAMA_INGEST_URL=http://localhost:11435

# --- LLM providers; classification decides which may be used (DESIGN 9.7) ---
ANTHROPIC_API_KEY=
WAYFINDER_PUBLIC_PROVIDERS=nvidia,groq,gemini
WAYFINDER_PRIVATE_PROVIDERS=anthropic

# --- authorization tuning (DESIGN 9.1.2) ---
WAYFINDER_GRANT_LEASE_SECONDS=600
WAYFINDER_VISIBILITY_LEASE_SECONDS=600
WAYFINDER_PUBLIC_CONNECTOR_LEASE_SECONDS=86400

# --- review handoff (scripts/review_handoff.py) ---
# Slack or Discord incoming webhook. Metadata only is ever posted: pull request number, title,
# counts, state, URL. No diff, no file contents. Leave empty to rely on GitHub notifications alone.
WAYFINDER_REVIEW_WEBHOOK_URL=

# --- agent identity (see AGENTS.md 6); set per session, not in .env ---
# WAYFINDER_AGENT=claude-code/opus-5
# WAYFINDER_SESSION=2026-09-21T09:00Z/1234
